# CareLoop Configuration

# MCP Server
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_ENDPOINT=/mcp

# Storage Backend: "sqlite" or "dynamodb"
STORAGE_BACKEND=sqlite

SQLITE_DB_PATH=careloop_local.db

# AWS Configuration (Used for DynamoDB and Amazon Bedrock LLM)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_NAME=CareLoopData
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Clock Mode: "system" or "simulated"
CLOCK_MODE=simulated
