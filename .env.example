# CareLoop Configuration Template
# For local development, leave AWS credentials blank to use SQLite and Console Notifier.

# Server & MCP Configuration
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_ENDPOINT=/mcp
ENVIRONMENT=development

# Storage Backend: "sqlite" (local demo) or "dynamodb" (AWS production)
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=careloop_local.db

# Notifier Type: "console" (local demo) or "sns" (AWS production)
NOTIFIER_TYPE=console

# Authentication Token (Optional in development, required in production mode)
# In production, bearer tokens are verified via Authorization: Bearer <token>
ALEXA_AUTH_TOKEN=

# AWS Configuration (Used when STORAGE_BACKEND=dynamodb or NOTIFIER_TYPE=sns or LLM is enabled)
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=CareLoopData
SNS_TOPIC_ARN=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
ALEXA_AUTH_TOKEN_SECRET_ARN=

# Clock Mode: "simulated" (for time-travel demo in simulator UI) or "system" (for real wall-clock production)
CLOCK_MODE=simulated
ESCALATION_TICK_INTERVAL_SECONDS=60.0

# Privacy & Data Retention (Days before automatic purge)
DATA_RETENTION_DAYS_EVENTS=90
DATA_RETENTION_DAYS_ALERTS=180
